 fn remove_bcachefs_attr(path: &Path, attr_name: &str) {
+    #[cfg(target_os = "linux")]
     if let Err(e) = removexattr(path, attr_name) {
         if e != rustix::io::Errno::NODATA && e != rustix::io::Errno::INVAL {
             eprintln!("error removing attribute {} from {}: {}",
                 attr_name, path.display(), e);
         }
     }
+    // FreeBSD: extattr_delete_file; ENOATTR is FreeBSD's ENODATA (option
+    // unset) and is the expected case when clearing.
+    #[cfg(target_os = "freebsd")]
+    if let Err(e) = crate::bsd_compat::removexattr(path, attr_name) {
+        if e.raw_os_error() != Some(libc::ENOATTR)
+            && e.raw_os_error() != Some(libc::EINVAL)
+        {
+            eprintln!("error removing attribute {} from {}: {}",
+                attr_name, path.display(), e);
+        }
+    }
 }
 
