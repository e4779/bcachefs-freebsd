+	/*
+	 * Cap the total wait at one daemon_timeout window from entry:
+	 * periodic signals restart the msleep with a fresh window each
+	 * time (EINTR path below), which can extend the wait indefinitely.
+	 * Observed with qbittorrent: a signaled thread never sees
+	 * ETIMEDOUT and stays wedged in fdisp_wait_answ forever
+	 * (bcachefs FUSE dogfood, 2026-11).
+	 */
+	slptime = deadline - ticks;
+	if (slptime <= 0)
