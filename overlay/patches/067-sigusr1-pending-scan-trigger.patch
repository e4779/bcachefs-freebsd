+/// retries the pending list on its own (device/config events request
+/// it; freespace recovery does not) - so work parked in a full-target
+/// era waits forever without this trigger.
 extern "C" fn kick_handler(_sig: c_int) {
     write_pipe_byte(PIPE_KICK);
 }
