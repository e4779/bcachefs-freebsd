 const SYSFS_BASE: &str = "/sys/fs/bcachefs/";
 
+/// The FreeBSD daemon's snapshot ring (fusemount telemetry): one dir per
+/// mounted filesystem, named by uuid, holding accounting.json.
+#[cfg(target_os = "freebsd")]
+const RING_BASE: &str = "/var/run/bcachefs-fuse";
+
+/// Resolve the mounted bcachefs a path is on, from the snapshot ring:
+/// its uuid and the devices the daemon mounted it from. Gates on statfs
+/// fstype "fusefs.bcachefs" first (kernel-only, no FUSE traffic, and it
+/// spares the ring scan for plain paths); the ring's mountpoint field -
+/// what mount(8) was given - says which entry is ours, which is what
+/// catches a stale entry (dead daemon, mount since replaced). A ringless
+/// mount returns None and the caller carries on down its not-mounted
+/// paths.
+#[cfg(target_os = "freebsd")]
+fn snapshot_lookup(path: &Path) -> Option<([u8; 16], Vec<std::path::PathBuf>)> {
+    use std::os::unix::ffi::OsStrExt;
+
+    // fstype gate first: kernel-only, no FUSE traffic, and it spares the
+    // ring scan for every plain path.
+    let c_path = std::ffi::CString::new(path.as_os_str().as_bytes()).ok()?;
+    let mut st: libc::statfs = unsafe { std::mem::zeroed() };
+    if unsafe { libc::statfs(c_path.as_ptr(), &mut st) } != 0 {
+        return None;
+    }
+    let fstype: String = {
+        let buf: Vec<u8> = st.f_fstypename.iter().map(|&ch| ch as u8).collect();
+        let end = buf.iter().position(|&b| b == 0).unwrap_or(buf.len());
+        String::from_utf8_lossy(&buf[..end]).into_owned()
+    };
+    if fstype != "fusefs.bcachefs" {
+        return None;
+    }
+
+    let ours = path.canonicalize().ok()?;
+
+    let dir = std::fs::read_dir(RING_BASE).ok()?;
+    for entry in dir.flatten() {
+        let text = match std::fs::read_to_string(entry.path().join("accounting.json")) {
+            Ok(t) => t,
+            Err(_) => continue,
+        };
+        let v: serde_json::Value = match serde_json::from_str(&text) {
+            Ok(v) => v,
+            Err(_) => continue,
+        };
+        let mountpoint = v.get("mountpoint").and_then(|m| m.as_str())
+            .and_then(|m| std::fs::canonicalize(m).ok());
+        if mountpoint.as_ref() != Some(&ours) {
+            continue;
+        }
+        let uuid_str = v.get("uuid").and_then(|u| u.as_str())?;
+        let uuid = parse_uuid(uuid_str).ok()?;
+        let devs = v.get("devices").and_then(|d| d.as_array())
+            .map(|arr| arr.iter()
+                .filter_map(|d| d.as_str().map(std::path::PathBuf::from))
+                .collect())
+            .unwrap_or_default();
+        return Some((uuid, devs));
+    }
+    None
+}
