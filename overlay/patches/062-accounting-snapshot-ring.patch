+/// Capacity/used/free in sectors, lock-free: the percpu usage sums and the
+/// published capacity field - the arithmetic usage_read_short() does under
+/// mark_lock, on the same numbers, without taking the lock.
+/// reserve_factor() is alloc/capacity.rs's, copied (it isn't exported).
+fn usage_short_external(fs: &Fs) -> (u64, u64, u64) {
+    let base = fs.usage_base();
+    let reserved = base.reserved.wrapping_add(fs.online_reserved());
+    let factor = reserved.wrapping_add(
+        reserved.next_multiple_of(1u64 << c::RESERVE_FACTOR) >> c::RESERVE_FACTOR);
+    let capacity = fs.capacity.capacity.get().wrapping_sub(base.hidden);
+    let used = capacity.min(base.data.wrapping_add(base.btree).wrapping_add(factor));
+    (capacity, used, capacity.wrapping_sub(used))
+}
+
+/// The snapshot ring write: /var/run/bcachefs-fuse/<uuid>/accounting.json,
+/// atomically (same-dir tmp + rename). One mem_read pass up front
+/// (collect_entries); no locks, and nothing borrowed from the fs by the
+/// time the file is written. Errors are logged and lived with - an
+/// unwritable /var/run must never take the mount down.
+fn write_snapshot(fs: &Fs, cfg: &Cfg, gen: u64) {
+    let entries = collect_entries(fs);
+
+    // The gate metrics, always whole: reconcile_work per type and
+    // dev_leaving per device, even where all-zero.
+    let mut reconcile = Map::new();
+    let mut leaving = Map::new();
+    for e in entries.iter() {
+        if let Some(name) = e.key.strip_prefix("rw_") {
+            reconcile.insert(name.to_string(), json!(e.counters));
+        } else if let Some(dev) = e.key.strip_prefix("leaving_dev") {
+            leaving.insert(dev.to_string(), json!(e.counters[0]));
+        }
+    }
+
+    let find = |key: &str| -> [u64; 3] {
+        entries.iter().find(|e| e.key == key).map_or([0, 0, 0], |e| e.counters)
+    };
+    let btree = find("btree_total");
+    let compression = find("compression_total");
+    let nr_inodes = find("nr_inodes");
+    let rebalance = find("rebalance");
+
+    // Top entries by largest counter, capped.
+    let mut top: Vec<(&Entry, u64)> = entries.iter()
+        .map(|e| (e, e.counters.iter().fold(0u64, |m, &v| m.max(v))))
+        .collect();
+    top.sort_by(|a, b| b.1.cmp(&a.1));
+    let top_json: Vec<Value> = top.into_iter().take(SNAPSHOT_TOP_MAX)
+        .map(|(e, _)| json!({ "pos": e.key, "v": e.counters }))
+        .collect();
+
+    let counters: Vec<u64> = (0..c::BCH_COUNTER_NR as usize)
+        .map(|i| fs.counter_read(i))
+        .collect();
+
+    let (capacity, used, free) = usage_short_external(fs);
+
+    let mut doc = Map::new();
+    // Stale must look stale: ts is the wall clock of the last write, gen
+    // counts writes within this mount, pid says which daemon.
+    doc.insert("provenance".into(), json!("live"));
+    doc.insert("ts".into(), json!(SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0.0, |d| d.as_secs_f64())));
+    doc.insert("gen".into(), json!(gen));
+    doc.insert("pid".into(), json!(std::process::id()));
+    doc.insert("uuid".into(), json!(cfg.uuid));
+    doc.insert("mountpoint".into(), json!(cfg.mountpoint));
+    doc.insert("devices".into(), json!(cfg.devs));
+    doc.insert("sectors".into(), json!({
+        "capacity": capacity, "used": used, "free": free,
+    }));
+    doc.insert("reconcile_work".into(), Value::Object(reconcile));
+    doc.insert("dev_leaving".into(), Value::Object(leaving));
+    doc.insert("btree_total".into(), json!(btree));
+    doc.insert("compression_total".into(), json!(compression));
+    doc.insert("nr_inodes".into(), json!(nr_inodes[0]));
+    doc.insert("rebalance_work".into(), json!(rebalance[0]));
+    doc.insert("counters".into(), json!(counters));
+    doc.insert("top".into(), Value::Array(top_json));
+
+    let text = Value::Object(doc).to_string();
+    let dir = &cfg.dir;
+    let result = (|| -> std::io::Result<()> {
+        std::fs::create_dir_all(dir)?;
+        let tmp = dir.join(".accounting.json.tmp");
+        std::fs::write(&tmp, text.as_bytes())?;
+        std::fs::rename(&tmp, dir.join("accounting.json"))?;
+        Ok(())
+    })();
+    if let Err(e) = result {
+        eprintln!("bcachefs fuse: telemetry: snapshot {}: {}", dir.display(), e);
+    }
+}
