+/// Unreachable on FreeBSD - fuse_claim() makes no mount, so there is nothing
+/// to detach - but the shared error paths in cmd_fusemount() and fuse_serve()
+/// call it, so it must exist. rustix's UnmountFlags are Linux-shaped; FreeBSD
+/// unmount(2) has no lazy MNT_DETACH, MNT_FORCE is the closest.
+#[cfg(target_os = "freebsd")]
+fn fuse_unclaim(mountpoint: &str) {
+    if let Ok(mp) = CString::new(mountpoint) {
+        let _ = unsafe { libc::unmount(mp.as_ptr(), libc::MNT_FORCE) };
+    }
