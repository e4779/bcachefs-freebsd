 /// Whether @dev is the source of a mounted FUSE filesystem: the same block
 /// device, or the same image file.
+#[cfg(target_os = "freebsd")]
+fn fuse_mounted(dev: &Path) -> bool {
+    // No /proc/self/mountinfo on FreeBSD: read the kernel's mount table with
+    // getmntinfo(3) - the same data mount(8) prints. Matching is
+    // best-effort: f_mntfromname is whatever the mount was given, and
+    // whether libfuse3's fsname= (MountOption::FSName, pushed in
+    // parse_fuse_mount_options()) survives into it is a smoke-test item. A
+    // miss only costs lock_devices() its fast "already in use" error - it
+    // falls to the WAIT_MAX arm - so this is error-path UX, not correctness.
+    let Some(dev) = dev.to_str() else { return false };
+    let name = |buf: &[u8]| match buf.iter().position(|&c| c == 0) {
+        Some(i) => String::from_utf8_lossy(&buf[..i]).into_owned(),
+        None => String::from_utf8_lossy(buf).into_owned(),
+    };
+    let mut mntbuf: *mut libc::statfs = std::ptr::null_mut();
+    let n = unsafe { libc::getmntinfo(&mut mntbuf, libc::MNT_NOWAIT) };
+    if n < 1 {
+        return false;
+    }
+    (0..n as usize).any(|i| {
+        let m = unsafe { &*mntbuf.add(i) };
+        name(&m.f_fstypename).starts_with("fuse") && name(&m.f_mntfromname) == dev
+    })
+}
