+/// Whether @dst_dir is @src itself or inside its subtree - the EINVAL
+/// case of POSIX rename(): a directory may not move into itself. The
+/// Linux VFS rejects it in may_move() before the filesystem is called;
+/// FreeBSD's fusefs(4) forwards the request, so the daemon checks. A
+/// directory has exactly one dirent naming it (bi_dir/bi_dir_offset),
+/// so walking those backpointers up from @dst_dir visits its ancestors,
+/// and only them: meeting @src on the way up means the destination
+/// lives inside the renamed directory. O(depth), capped: past the cap
+/// the answer is "not inside", and rename_trans()'s own checks govern
+/// what follows - a corrupt backpointer loop must not spin the daemon.
+fn rename_dst_inside_src(fs: &Fs, src: c::subvol_inum, dst_dir: c::subvol_inum) -> bool {
+    // A path component costs at least one character plus the separator,
+    // so no honest path is deeper than PATH_MAX/2.
+    const MAX_ANCESTRY: u32 = 512;
+
+    let mut cur = dst_dir;
+    for _ in 0..MAX_ANCESTRY {
+        if cur.subvol == src.subvol && cur.inum == src.inum {
+            return true;
+        }
 
+        let Ok(inode) = inode::find_by_inum(fs, cur) else { return false };
+
+        // The walk ends at the filesystem's root, or at an inode no
+        // dirent names, as namei.rs's inum_to_path_up() ends it.
+        if inode.bi_subvol as u64 == BCACHEFS_ROOT_SUBVOL &&
+           inode.bi_inum == BCACHEFS_ROOT_INO {
+            return false;
+        }
+        if inode.bi_dir == 0 && inode.bi_dir_offset == 0 {
+            return false;
+        }
+
+        // A subvolume root is named in its parent subvolume; every other
+        // inode, in its own.
+        if inode.bi_parent_subvol != 0 {
+            cur.subvol = inode.bi_parent_subvol as u64;
+        }
+        cur.inum = inode.bi_dir;
+    }
+    false
+}
