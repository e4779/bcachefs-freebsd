-fn fd_metadata(fd: RawFd) -> Metadata {
-    match std::fs::metadata(format!("/proc/self/fd/{}", fd)) {
-        Ok(metadata) => metadata,
-        Err(_) => {
-            crate::wrappers::super_io::die("stat error");
-        }
+fn fd_metadata(fd: RawFd) -> libc::stat {
+    // FreeBSD: /proc is not mounted by default, so /proc/self/fd/N cannot
+    // be stat'ed - fstat(2) the descriptor directly, as the C xfstat().
+    let mut st: libc::stat = unsafe { std::mem::zeroed() };
+    if unsafe { libc::fstat(fd, &mut st) } != 0 {
+        crate::wrappers::super_io::die("stat error");
     }
+    st
 }
+
+/// file_type().is_block_device(), for a libc::stat: S_IFMT == S_IFBLK
+/// (0o170000 == 0o060000, same encoding as on Linux).
+fn is_block_device(st: &libc::stat) -> bool {
+    st.st_mode & 0o170000 == 0o060000
+}
